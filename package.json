{
  "name": "inplan-model-uploader",
  "version": "0.2.2",
  "private": true,
  "description": "App for upload STL models and PTS cutlines to InPlan",
  "author": {
    "name": "OrthoIN3D",
    "email": "support@orthoin3d.com"
  },
  "homepage": "https://app.orthoin3d.com",
  "license": "MIT",
  "keywords": [
    "inplan",
    "model",
    "uploader"
  ],
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "test:smoke": "electron test/smoke/electron-smoke.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "dependencies": {
    "axios": "1.20.0",
    "electron-updater": "6.8.9",
    "form-data": "4.0.6"
  },
  "devDependencies": {
    "electron": "43.7.5",
    "electron-builder": "26.16.1"
  },
  "build": {
    "appId": "com.inplan.modeluploader",
    "productName": "iNPLAN Model uploader",
    "copyright": "Copyright © 2026 OrthoIN3D",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "build/icons/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "build/icons",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": false,
      "artifactName": "iNPLAN-Model-uploader-${version}-Setup.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ORTHOIN3D",
        "repo": "Model-uploader-iNPLAN"
      }
    ]
  }
}
